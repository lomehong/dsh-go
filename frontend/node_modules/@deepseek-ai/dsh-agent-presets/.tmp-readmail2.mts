/** TEMP: 只读查收 dsh-pc 收件箱（drain 不 ack = 不删除）。 */
import { Context } from '@deepseek-ai/cordis'
import Loader from '@deepseek-ai/cordis-plugin-loader'
import Include from '@deepseek-ai/cordis-plugin-include'
import Group from '@deepseek-ai/cordis-plugin-group'
import AgentRegistry from '@deepseek-ai/dsh-agent'
import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
import ToolRuntime from '@deepseek-ai/dsh-tools'
import FileSettingsProvider from '@deepseek-ai/dsh-settings-file'
import LocalCredentialProvider from '@deepseek-ai/dsh-credentials-local'

const PROFILE_DIR = 'file:///C:/Users/hz0704027/.dsh/profiles/web/'
const DSH_HOME = 'C:/Users/hz0704027/.dsh'

const ctx = new Context()
ctx.baseUrl = PROFILE_DIR
await ctx.plugin(Loader)
ctx.loader.builtins.include = Include
ctx.loader.builtins.group = Group
await ctx.plugin(SystemPrompt, { persona: '' })
await ctx.plugin(ToolRuntime)
await ctx.plugin(AgentRegistry)
await ctx.plugin(FileSettingsProvider, { path: `${DSH_HOME}/settings.yaml`, watch: false })
await ctx.plugin(LocalCredentialProvider, { path: `${DSH_HOME}/.credentials.yaml`, watch: false })
ctx.provide('launchEnvironment', { get: () => undefined, getFrom: () => undefined })
await ctx.loader.create({ name: 'dsh-yuyi' })
await ctx.get('loader')?.await()

const yuyi = ctx.get('yuyi') as {
  status(): { connected: boolean }
  hubInboxDrain(): Promise<Array<{ message: { id: string; text: string; mode: string; time: number; taskId?: string; replyTo?: string; from: { device: string; name?: string; sessionID: string } } }>>
  inboxRead(target: 'device', peek: boolean): Array<{ message: { text: string; from: { device: string; name?: string; sessionID: string } } }>
}
const deadline = Date.now() + 12_000
while (!yuyi.status().connected && Date.now() < deadline) await new Promise(r => setTimeout(r, 250))
console.log('connected:', yuyi.status().connected)

const hubMail = await yuyi.hubInboxDrain()
console.log(`\n== hub 侧收件箱（${hubMail.length} 条，未清除）==`)
for (const entry of hubMail) {
  const m = entry.message
  const from = `${m.from.name ?? m.from.sessionID}@${m.from.device}`
  console.log(`- [${new Date(m.time).toLocaleString('zh-CN')}] ${from} (${m.mode})${m.replyTo !== undefined ? ' [回信]' : ''}:\n${m.text}\n`)
}
const deviceMail = yuyi.inboxRead('device', true)
console.log(`== 本机设备收件箱（${deviceMail.length} 条）==`)
for (const entry of deviceMail) console.log(`- ${entry.message.text.slice(0, 120)}`)
process.exit(0)
